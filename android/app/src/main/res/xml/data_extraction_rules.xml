<?xml version="1.0" encoding="utf-8"?>
<!--
  REGLAS DE EXTRACCIÓN DE DATOS (Android 12+ — dataExtractionRules).
  Igual objetivo que backup_rules.xml: el localStorage del juego vive en
  app_webview/ (raíz de datos internos, NO files/) → domain="root" para
  que el respaldo en la nube y la transferencia de dispositivo lo lleven
  de verdad. PETICIÓN DEL JUGADOR: reinstalar o mudar de móvil no puede
  borrar el progreso.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview" />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="external" path="." />
        <exclude domain="file" path="cache" />
        <exclude domain="root" path="cache" />
        <exclude domain="root" path="code_cache" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview" />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="external" path="." />
        <exclude domain="file" path="cache" />
        <exclude domain="root" path="cache" />
        <exclude domain="root" path="code_cache" />
    </device-transfer>
</data-extraction-rules>
