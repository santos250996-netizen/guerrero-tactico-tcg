<?xml version="1.0" encoding="utf-8"?>
<!--
  RESPALDO AUTOMÁTICO (Android 11 y anteriores — fullBackupContent).
  El progreso del juego vive en el localStorage del WebView, que Android
  guarda en app_webview/ — un HERMANO de files/, NO dentro. La versión
  original solo incluía domain="file" (files/) y el localStorage no viajaba
  al backup. Con domain="root" path="app_webview" el estado del juego SÍ va
  a Google Auto Backup. NOTA LINT (FullBackupContent): con includes
  explícitos, todo exclude debe estar DENTRO de un include → NO añadir
  excludes de root/cache ni root/code_cache: al no estar incluidos jamás
  entraron en el backup y Lint los marca como FATAL (lintVitalRelease).
-->
<full-backup-content>
    <include domain="root" path="app_webview" />
    <include domain="file" path="." />
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <include domain="external" path="." />
    <exclude domain="file" path="cache" />
</full-backup-content>
