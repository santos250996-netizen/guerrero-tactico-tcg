// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Match {
  id           String   @id @default(cuid())
  result       String
  playerWins   Int
  enemyWins    Int
  draws        Int
  turnsPlayed  Int
  scorePlayer  Int
  scoreEnemy   Int
  laneArmasP   Int
  laneArmasE   Int
  laneProtP    Int
  laneProtE    Int
  laneFuriaP   Int
  laneFuriaE   Int
  createdAt    DateTime @default(now())
}

model CustomCard {
  id        String   @id @default(cuid())
  defId     String   @unique
  name      String
  category  String
  subtypes  String
  cost      Int
  power     Int
  text      String
  effectId  String
  rarity    String   @default("common")
  createdAt DateTime @default(now())
}

model Deck {
  id        String   @id @default(cuid())
  name      String   @default("Mazo Guerrero")
  cardIds   String
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
