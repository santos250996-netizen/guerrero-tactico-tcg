// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// PvP LOCAL (hotspot/WiFi) — salas en vivo + historial de resultados.
// PvpRoom guarda el estado COMPLETO de la partida como JSON (server-authoritative,
// el motor corre en el servidor). PvpMatch archiva el resultado al terminar.
// ============================================================================
model PvpRoom {
  code      String   @id
  stateJson String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PvpMatch {
  id          String   @id @default(cuid())
  code        String
  nameA       String
  nameB       String
  classA      String
  classB      String
  winsA       Int
  winsB       Int
  draws       Int
  scoreA      Int
  scoreB      Int
  turnsPlayed Int
  winnerSide  String
  createdAt   DateTime @default(now())
}
